{
  "name": "starlightdown-starlight",
  "version": "0.0.0",
  "description": "Starlight plugin and Editorial Scientific theme for R package documentation generated by starlightdown.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./index.mjs",
    "./schema": "./schema.mjs",
    "./route-middleware": "./middleware.mjs",
    "./ec-config": "./ec-config.mjs",
    "./ec/output-frames": "./ec/output-frames.mjs",
    "./virtual": "./virtual.d.ts",
    "./components/*": "./components/*",
    "./styles/*": "./styles/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "ec-config.mjs",
    "schema.mjs",
    "schema.d.mts",
    "middleware.mjs",
    "virtual.d.ts",
    "ec",
    "components",
    "styles",
    "CONTRACT.md"
  ],
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0"
  },
  "peerDependencies": {
    "@astrojs/starlight": "^0.41.0",
    "astro": "^7.0.2"
  },
  "keywords": [
    "starlight",
    "starlight-plugin",
    "astro",
    "documentation",
    "r"
  ]
}
